
(defwindow timectl
  :geometry (geometry
              :x "0%"
              :y "0%"
              :width 350
              :height 0
              :anchor "bottom right")
  :monitor 0 
  :stacking "overlay"
  (revealer
    :reveal revealtimectl 
    :transition "slideup"
    (box
      :orientation "v"
      :valign "end"
      :space-evenly false
      (box
        :height 650
        :class "popup"
          (notificationlog))

      (box
        :class "popup"
        (datecalendar))
      )))

(defwidget datecalendar [] 
  (box
    :class "widget"
    :orientation "v"
    :space-evenly false

    (box 
      :orientation "h"
      :space-evenly false
      :spacing 20
      :halign "center"
      :valign "center"
      :class "calhead"
      (button 
        :onclick "${EWW_CMD} update calendar_year=${calendar_month == 1 ? calendar_year - 1 : calendar_year} calendar_month=${calendar_month == 1 ? 12 : calendar_month - 1}"
        (label 
          :class "icon"
          :angle 180
          :text ""))
      (label 
        :class "calheadinfo"
        :text "${months[calendar_month]} ${calendar_year}")
      (button 
        :onclick "${EWW_CMD} update calendar_year=${calendar_month == 12 ? calendar_year + 1 : calendar_year} calendar_month=${calendar_month == 12 ? 1 : calendar_month + 1}"
        (label 
          :class "icon"
          :text "")))

    (box 
      :class "calwrap"
      (calendar 
        :month calendar_month
        :year calendar_year
        :show-heading false))))

(defwidget notificationlog []
  (box 
    :width 320
    :space-evenly false 
    :orientation "v"
    :class "widget"
    (scroll
      :hscroll false
      :vscroll true
      :vexpand true
      :valign "fill"
      (box
        :orientation "v" 
        :valign "start"
        :space-evenly false
        (revealer 
          :reveal { psong != "" }
          (singlenotif 
            :noti '{
              "app": "media",
              "image": "${pcover}",
              "id": "",
              "summary": "${psong}",
              "body": "${partist}",
              "time": "${ptime.readable}",
              "actions": []
            }' 
            :class "notifbox"
            :music true))

        (for noti in {notifications.notifications}
          (singlenotif :noti noti :class "notifbox"))
        ))

    (box 
      :orientation "h"
      (button
        :onclick "./scripts/notifManage --clear"
        (label
          :class "icontitle"
          :text "Clear All"))
      (button
        :onclick "./scripts/notifManage --toggle"
        (label
          :class { notifications.dnd ? "icontitleon" : "icontitle"}
          :text "Do Not Disturb")))))

